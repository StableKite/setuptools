         'platlib': '{base}/{platlibdir}/{implementation_lower}',
         'headers': '{base}/include/{implementation_lower}/{dist_name}',
+        'scripts': '{base}/bin',
+        'data': '{base}',
+    },
+    # Keep the Debian setuptools package usable with a vanilla interpreter,
+    # where Python's optional _distutils_system_mod and deb_system scheme
